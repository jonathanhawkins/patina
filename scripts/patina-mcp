#!/usr/bin/env python3
"""Call a Patina editor MCP tool from the shell.

    scripts/patina-mcp <tool> ['<json arguments>']     e.g.
    scripts/patina-mcp status
    scripts/patina-mcp play '{"frames": 120, "inputs": [{"action": "jump", "at": 10}]}'
    scripts/patina-mcp tools                           # list tools and their descriptions

Talks JSON-RPC to http://127.0.0.1:$PATINA_PORT/mcp (default port 8080). Text
results print to stdout; images are written to $PATINA_SHOTS (default
$TMPDIR/patina-shots) and their paths printed. Exit status 1 when the tool
reports an error. Set PATINA_TOKEN if the editor was started with an auth token.
"""
import base64
import json
import os
import sys
import time
import urllib.error
import urllib.request

PORT = os.environ.get("PATINA_PORT", "8080")
URL = f"http://127.0.0.1:{PORT}/mcp"
SHOTS = os.environ.get("PATINA_SHOTS") or os.path.join(os.environ.get("TMPDIR", "/tmp"), "patina-shots")


def rpc(method, params):
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
    req = urllib.request.Request(URL, data=body, headers={"Content-Type": "application/json"})
    if os.environ.get("PATINA_TOKEN"):
        req.add_header("Authorization", "Bearer " + os.environ["PATINA_TOKEN"])
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            return json.loads(resp.read())
    except urllib.error.URLError as e:
        sys.exit(f"patina-mcp: cannot reach {URL}: {e} (is the editor running? set PATINA_PORT)")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    tool = sys.argv[1]
    if tool == "tools":
        for t in rpc("tools/list", {})["result"]["tools"]:
            print(f"{t['name']}: {t['description']}\n")
        return 0
    args = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
    reply = rpc("tools/call", {"name": tool, "arguments": args})
    if "error" in reply:
        print(f"rpc error: {reply['error']}", file=sys.stderr)
        return 2
    result = reply["result"]
    os.makedirs(SHOTS, exist_ok=True)
    stamp = time.strftime("%H%M%S")
    shot = 0
    for block in result.get("content", []):
        if block.get("type") == "text":
            print(block["text"].rstrip("\n"))
        elif block.get("type") == "image":
            shot += 1
            path = os.path.join(SHOTS, f"{tool}-{stamp}-{shot}.png")
            with open(path, "wb") as f:
                f.write(base64.b64decode(block["data"]))
            print(f"[image] {path}")
    return 1 if result.get("isError") else 0


if __name__ == "__main__":
    sys.exit(main())
